# Arslan Dojo — Production Environment Variables (Railway / Docker)
# Copy values into Railway Service Variables (never commit real secrets).

# Gateway & internal ports
PORT=8080
COACH_PORT=4174
MEMBER_PORT=4173
STORAGE_PORT=4175

# Persistent volume paths (mount a Railway Volume at /data and point ARSLAN_DATA_DIR there)
ARSLAN_DATA_DIR=/data
ARSLAN_DB=
ARSLAN_STORAGE_DIR=

# Shared security secrets (required in multi-service deployments)
ARSLAN_STORAGE_SECRET=
ARSLAN_INTERNAL_PROXY_TOKEN=

# Optional separate public storage origin (if using a dedicated storage domain)
STORAGE_PUBLIC_URL=

# Optional separate members portal domain (omit if sharing single gateway domain)
MEMBERS_SITE_URL=

# External verified payment portal (HTTPS URL only)
PAYMENT_PORTAL_URL=

# Google Sign-In OAuth client IDs (comma-separated allowed client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Gemini API key for AI features (if unset, status gracefully reports "تنظیم نشده")
GEMINI_API_KEY=

# Never enable test fixtures or DB reset in production
# DOJO_TEST_FIXTURES=0
# RESET_DB=0
